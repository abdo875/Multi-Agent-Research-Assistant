# AgentForge Configuration
# Application Mode: 'mock' (default, no API key needed), 'hosted' (OpenAI-compatible), or 'vllm' (local vLLM instance)
APP_MODE=mock

# LLM Provider Configuration (OpenAI-compatible API)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60

# Agent Workflow Settings
MAX_REVISION_ATTEMPTS=1

# Optional LangSmith Tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentforge
